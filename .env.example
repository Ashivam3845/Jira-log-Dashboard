# Copy to .env for local development. Never commit .env or real credentials.
ENV=LOCAL
PORT=5302

# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRY_MINUTES=1440
SKIP_AUTH=false

# Initial administrator is created only when the database has no users.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional AWS Secrets Manager configuration
AWS_REGION=us-east-1
AWS_SECRET_NAME=

# Optional Elastic APM
APM_URL=
APM_TOKEN=
